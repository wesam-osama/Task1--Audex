# ========== BACKEND CONFIGURATION ==========
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ========== DATABASE ==========
# Example: mongodb+srv://user:[REDACTED]@cluster.mongodb.net/dbname?retryWrites=true&w=majority
DB_URL=your_secure_mongodb_connection_string

# ========== AUTHENTICATION ==========
JWT_SECRET=your_strong_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ========== API KEYS ==========
# Add any third-party API keys here

# ========== FRONTEND ==========
# Backend API URL accessible from frontend
VITE_API_URL=http://backend:5000
